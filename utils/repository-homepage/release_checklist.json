{
  "checks": [
    {
      "id": "readme-release-call",
      "kind": "readme_contains",
      "pattern": "## Monthly Release & Community Call",
      "description": "README exposes the monthly release entry point"
    },
    {
      "id": "autorelease-workflow",
      "kind": "path_exists",
      "path": ".github/workflows/auto_releases.yml",
      "description": "Scheduled auto release workflow exists"
    },
    {
      "id": "create-release-workflow",
      "kind": "path_exists",
      "path": ".github/workflows/create_release.yml",
      "description": "Release creation workflow exists"
    },
    {
      "id": "autorelease-script",
      "kind": "path_exists",
      "path": "tests/ci/auto_release.py",
      "description": "Release branch readiness script exists"
    },
    {
      "id": "create-release-script",
      "kind": "path_exists",
      "path": "tests/ci/create_release.py",
      "description": "Release orchestration script exists"
    },
    {
      "id": "changelog-directory",
      "kind": "path_exists",
      "path": "docs/changelogs",
      "description": "Release changelog destination exists"
    }
  ]
}
