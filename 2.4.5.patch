+# ClickHouse Community Channels Configuration
+# =============================================
+# This file centralizes all community channel URLs and contact information.
+# Used by README.md, documentation, and various scripts to ensure consistency.
+#
+# To update community links, modify this file and run:
+#   ./community/generate_links.sh
+
+# ============================================================================
+# Official Channels
+# ============================================================================
+
+[official]
+website=https://clickhouse.com
+cloud=https://clickhouse.cloud
+docs=https://clickhouse.com/docs
+blog=https://clickhouse.com/blog
+careers=https://clickhouse.com/company/careers
+contact=https://clickhouse.com/company/contact
+presentations=https://presentations.clickhouse.com
+
+# ============================================================================
+# Social Media
+# ============================================================================
+
+[social]
+slack=https://clickhouse.com/slack
+telegram_en=https://telegram.me/clickhouse_en
+telegram_ru=https://telegram.me/clickhouse_ru
+youtube=https://www.youtube.com/c/ClickHouseDB
+bluesky=https://bsky.app/profile/clickhouse.com
+twitter=https://x.com/ClickHouseDB
+github=https://github.com/ClickHouse/ClickHouse
+
+# ============================================================================
+# Documentation Links
+# ============================================================================
+
+[docs]
+getting_started=https://clickhouse.com/docs/getting_started/tutorial
+install=https://clickhouse.com/docs/install
+quick_start=https://clickhouse.com/docs/quick-start
+cloud_docs=https://clickhouse.com/docs/cloud
+
+# ============================================================================
+# Community Events
+# ============================================================================
+
+[events]
+events_page=https://clickhouse.com/company/news-events
+release_calls=https://clickhouse.com/company/events
+luma=https://luma.com/clickhouse
+meetup_playlist=https://www.youtube.com/playlist?list=PL0Z2YDlm0b3jAlSy1JxyP8zluvXaN3nxU
+
+# ============================================================================
+# Development Resources
+# ============================================================================
+
+[dev]
+github_dev=https://github.dev/ClickHouse/ClickHouse
+ci_dashboard=https://github.com/ClickHouse/ClickHouse/actions
+issues=https://github.com/ClickHouse/ClickHouse/issues
+pull_requests=https://github.com/ClickHouse/ClickHouse/pulls
+contributing=https://github.com/ClickHouse/ClickHouse/blob/master/CONTRIBUTING.md
+
+# ============================================================================
+# Support Channels (Priority Order)
+# ============================================================================
+
+[support]
+# Primary: Slack for real-time chat
+primary=slack
+# Secondary: Telegram for alternative chat
+secondary=telegram_en
+# Tertiary: GitHub issues for bug reports
+tertiary=github_issues
+# Email for career inquiries
+careers_email=careers@clickhouse.com
