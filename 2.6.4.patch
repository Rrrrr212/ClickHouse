+CREATE TABLE empty_range_decompress
+(
+    id UInt64 CODEC(Delta, ZSTD),
+    category LowCardinality(String),
+    val Float64 CODEC(Gorilla, ZSTD)
+) ENGINE = MergeTree ORDER BY (category, id)
