@@ -0,0 +1,187 @@
+# ClickHouse Monthly Release Checklist
+# 
+# This file defines the checklist items for the monthly release process.
+# It is consumed by the release_checklist.py script.
+#
+# Usage:
+#   python3 tools/release/release_checklist.py --month 2026-06
+#   python3 tools/release/release_checklist.py --validate
+#   python3 tools/release/release_checklist.py --report
+
+version: 1
+release_cadence: monthly
+
+phases:
+  - id: pre_release
+    name: "Pre-Release Preparation"
+    order: 1
+    responsible: "Release Manager"
+    checklist:
+      - id: "verify-ci-green"
+        name: "Verify CI is green on the release branch"
+        description: "Check that all CI workflows for the release branch have passed"
+        automated: true
+        check_command: "python3 ci/defs/defs.py --check-branch {branch}"
+
+      - id: "review-changelog"
+        name: "Review and categorize changelog entries"
+        description: "Ensure all merged PRs have proper changelog categories"
+        automated: true
+        check_command: "python3 tests/ci/changelog.py --check-branch {branch}"
+
+      - id: "check-documentation"
+        name: "Verify documentation PRs are merged"
+        description: "Check that all documentation updates for new features are in"
+        automated: true
+        check_command: "python3 -m ci.jobs.docs_job --check-sync"
+
+      - id: "version-bump"
+        name: "Bump version numbers"
+        description: "Update version in all relevant files (CMakeLists.txt, etc.)"
+        automated: true
+        check_command: "python3 tests/ci/version_helper.py --bump {branch}"
+
+      - id: "security-review"
+        name: "Review security changelog"
+        description: "Check for any pending security fixes to include"
+        automated: false
+        manual_steps:
+          - "Review SECURITY.md for any pending advisories"
+          - "Check Bugcrowd for unresolved reports"
+          - "Verify all security patches are cherry-picked"
+
+      - id: "backward-compat"
+        name: "Check backward compatibility"
+        description: "Run backward compatibility tests against previous release"
+        automated: true
+        check_command: "python3 ci/jobs/compatibility_check.py --previous-version {previous_version}"
+
+      - id: "performance-benchmark"
+        name: "Performance benchmark comparison"
+        description: "Run performance benchmarks and compare with previous release"
+        automated: true
+        check_command: "python3 ci/jobs/performance_tests.py --compare-with {previous_version}"
+
+  - id: tag_release
+    name: "Tag and Build Release"
+    order: 2
+    responsible: "Release Manager"
+    checklist:
+      - id: "create-tag"
+        name: "Create the release tag"
+        description: "Tag the release commit with the version number"
+        automated: true
+        check_command: "python3 tests/ci/create_release.py --prepare-release-info --ref {branch} --release-type patch"
+
+      - id: "build-binaries"
+        name: "Build binary packages"
+        description: "Trigger binary builds for all platforms"
+        automated: true
+        check_command: "gh workflow run create_release.yml --ref {branch} --field type=patch"
+
+      - id: "verify-signatures"
+        name: "Verify package signatures"
+        description: "Ensure all packages are properly signed"
+        automated: false
+        manual_steps:
+          - "Download all packages from the release"
+          - "Verify GPG signatures for each package"
+          - "Check SHA256 checksums"
+
