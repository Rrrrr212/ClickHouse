+# ClickHouse Release Checklist
+
+checklist:
+  - id: ci_status
+    name: CI Status Verification
+    description: Verify all CI checks are passing on the release commit
+    steps:
+      - Check GitHub Actions status
+      - Verify Praktika test results
+      - Check sanitizer builds
+    command: "python3 tests/ci/check_ci_status.py"
+    critical: true
+
+  - id: documentation
+    name: Documentation Updates
+    description: Ensure all documentation is up to date
+    steps:
+      - Update version references
+      - Check for breaking changes documentation
+      - Verify release notes
+    command: "python3 utils/generate-system-tables-docs"
+    critical: true
+
+  - id: performance
+    name: Performance Test Results
+    description: Verify no performance regressions
+    steps:
+      - Compare with previous release
+      - Check for slow queries
+      - Verify memory usage
+    command: "python3 .claude/tools/fetch_perf_report.py"
+    critical: true
+
+  - id: security
+    name: Security Audit
+    description: Perform security checks
+    steps:
+      - Update security.md
+      - Check for known vulnerabilities
+      - Verify dependencies
+    command: "python3 utils/security-generator/generate_security.py"
+    critical: true
+
+  - id: release_notes
+    name: Release Notes Preparation
+    description: Prepare and review release notes
+    steps:
+      - Generate changelog
+      - Highlight major features
+      - List breaking changes
+    command: "python3 tests/ci/changelog.py"
+    critical: true
+
+  - id: community_announcement
+    name: Community Announcement
+    description: Prepare community communication
+    steps:
+      - Draft release call announcement
+      - Prepare blog post
+      - Schedule social media posts
+    command: "python3 tools/release/notifications.py --draft"
+    critical: false
